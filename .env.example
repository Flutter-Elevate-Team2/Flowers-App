# ── Flowery App — Environment Variables Template ─────────────────────────────
#
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your real values in .env
# 3. NEVER commit .env  (it is git-ignored)
# ─────────────────────────────────────────────────────────────────────────────

# API base URL for the Flowery backend
BASE_URL= BASE_URL

# Mapbox public access token (starts with pk.)
# Get yours at: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_PUBLIC_TOKEN_HERE
